# ──────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────
# URL pública oficial (usada em metadata/OG, canonical, JSON-LD, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://maxdigitalstudio.com.br

# ──────────────────────────────────────────────
# WhatsApp — CTA primário do site
# Formato internacional, só dígitos, sem "+" (ex: 5511999999999)
# ──────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP=351936212180

# ──────────────────────────────────────────────
# E-mail do formulário "Monte sua proposta ideal" (Resend)
# Deixe RESEND_API_KEY vazio para operar só com fallback de WhatsApp.
# CONTACT_FROM_EMAIL precisa de domínio verificado no Resend; até lá, use onboarding@resend.dev.
# ──────────────────────────────────────────────
CONTACT_TO_EMAIL=contato@maxdigitalstudio.com.br
CONTACT_FROM_EMAIL=contato@maxdigitalstudio.com.br
RESEND_API_KEY=

# ──────────────────────────────────────────────
# Google Analytics (GA4) — opcional
# Carrega apenas em produção. Se vazio, usa o ID padrão do código.
# ──────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-Z8NH8HTECB

# ──────────────────────────────────────────────
# Meta Pixel (Facebook/Instagram Ads) — opcional
# Vazio = desligado. Preencha com o ID do Pixel (Meta Events Manager) para ativar.
# ──────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
